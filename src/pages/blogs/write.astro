---
import Base from "../../layouts/Base.astro";
import { formatBlogDate } from "../../lib/blog";
import { getSessionFromCookie } from "../../lib/auth";
import { getBlogPostForAuthor, getBlogPostsForAuthor } from "../../lib/db";

export const prerender = false;

const session = getSessionFromCookie(Astro.request.headers.get("cookie"));

if (!session) {
  return Astro.redirect(
    `/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`,
    302,
  );
}

const posts = await getBlogPostsForAuthor(session.sub);
const requestedPostId = Number(Astro.url.searchParams.get("post"));
const selectedPost =
  Number.isInteger(requestedPostId) && requestedPostId > 0
    ? await getBlogPostForAuthor(session.sub, requestedPostId)
    : null;
const activePost = selectedPost ?? null;
const displayName = session.name ?? session.email ?? "Hack Clubber";
const postsJson = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<Base title="Write Blog" description="Write and publish Hack Club Wiki blogs." noindex>
  <main class="write-page">
    <header class="write-header">
      <div>
        <p class="write-eyebrow">Blog studio</p>
        <h1>Write and publish</h1>
      </div>
      <div class="write-user">
        <a href="/blogs">Published blogs</a>
        <span>{displayName}</span>
        <a href="/auth/logout">Sign out</a>
      </div>
    </header>

    <div class="write-shell">
      <aside class="post-sidebar" aria-label="Your blog posts">
        <button class="new-post-btn" type="button" id="new-post-btn">New post</button>
        <div class="post-list" id="post-list">
          {posts.length > 0 ? (
            posts.map((post) => (
              <a
                class:list={[
                  "post-list-item",
                  activePost?.id === post.id && "post-list-item--active",
                ]}
                href={`/blogs/write?post=${post.id}`}
                data-post-id={post.id}
              >
                <span>{post.title}</span>
                <small>
                  {post.status === "published" ? "Published" : "Draft"} · {formatBlogDate(post.updated_at)}
                </small>
              </a>
            ))
          ) : (
            <p class="empty-list">No drafts yet.</p>
          )}
        </div>
      </aside>

      <section class="editor-panel">
        <form class="write-form" id="blog-post-form" data-post-id={activePost?.id ?? ""}>
          <label>
            <span>Title</span>
            <input
              type="text"
              name="title"
              value={activePost?.title ?? ""}
              placeholder="What are you writing about?"
              autocomplete="off"
              required
            />
          </label>

          <label>
            <span>Excerpt</span>
            <input
              type="text"
              name="excerpt"
              value={activePost?.excerpt ?? ""}
              placeholder="A short summary for the public blog list"
              autocomplete="off"
            />
          </label>

          <label>
            <span>Body</span>
            <textarea
              name="body"
              rows="18"
              placeholder="Write your draft here. Basic Markdown works: headings, lists, bold, italic, and links."
              required>{activePost?.body ?? ""}</textarea
            >
          </label>

          <div class="write-actions">
            <p class="write-status" id="write-status" role="status" aria-live="polite">
              {activePost
                ? activePost.status === "published"
                  ? "Published"
                  : "Draft"
                : "New draft"}
            </p>
            <div class="write-buttons">
              {activePost?.status === "published" && activePost.slug ? (
                <a class="secondary-action" href={`/blogs/${activePost.slug}`}>View</a>
              ) : null}
              <button type="button" class="secondary-action" id="delete-btn" disabled={!activePost}>
                Delete
              </button>
              {activePost?.status === "published" ? (
                <button type="button" class="secondary-action" id="unpublish-btn">
                  Unpublish
                </button>
              ) : null}
              <button type="submit">Save draft</button>
              <button type="button" id="publish-btn">Publish</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </main>

  <script type="application/json" id="blog-posts-data" set:html={postsJson}></script>

  <script is:inline>
    const form = document.getElementById("blog-post-form");
    const status = document.getElementById("write-status");
    const newPostBtn = document.getElementById("new-post-btn");
    const publishBtn = document.getElementById("publish-btn");
    const unpublishBtn = document.getElementById("unpublish-btn");
    const deleteBtn = document.getElementById("delete-btn");
    const titleInput = form?.querySelector('[name="title"]');
    const excerptInput = form?.querySelector('[name="excerpt"]');
    const bodyInput = form?.querySelector('[name="body"]');

    function setBusy(isBusy) {
      form?.querySelectorAll("button").forEach((button) => {
        button.disabled = isBusy || (button.id === "delete-btn" && !form.dataset.postId);
      });
    }

    function getPayload() {
      const formData = new FormData(form);
      return {
        title: String(formData.get("title") || ""),
        excerpt: String(formData.get("excerpt") || ""),
        body: String(formData.get("body") || ""),
      };
    }

    async function requestJson(url, options) {
      const response = await fetch(url, {
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        ...options,
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data?.error || "Something went wrong.");
      return data;
    }

    async function saveDraft() {
      const postId = form.dataset.postId;
      const payload = getPayload();
      status.textContent = "Saving...";
      setBusy(true);

      try {
        const data = postId
          ? await requestJson(`/api/blogs/${postId}`, {
              method: "PATCH",
              body: JSON.stringify({ ...payload, action: "save" }),
            })
          : await requestJson("/api/blogs/drafts", {
              method: "POST",
              body: JSON.stringify(payload),
            });

        status.textContent = "Draft saved.";
        if (!postId && data?.draft?.id) {
          window.location.href = `/blogs/write?post=${data.draft.id}`;
        }
        return data.post || data.draft;
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Failed to save draft.";
        return null;
      } finally {
        setBusy(false);
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      await saveDraft();
    });

    publishBtn?.addEventListener("click", async () => {
      const saved = await saveDraft();
      const postId = saved?.id || form.dataset.postId;
      if (!postId) return;

      status.textContent = "Publishing...";
      setBusy(true);
      try {
        const data = await requestJson(`/api/blogs/${postId}`, {
          method: "PATCH",
          body: JSON.stringify({ action: "publish" }),
        });
        window.location.href = `/blogs/write?post=${data.post.id}`;
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Failed to publish.";
      } finally {
        setBusy(false);
      }
    });

    unpublishBtn?.addEventListener("click", async () => {
      const postId = form.dataset.postId;
      if (!postId) return;

      status.textContent = "Unpublishing...";
      setBusy(true);
      try {
        await requestJson(`/api/blogs/${postId}`, {
          method: "PATCH",
          body: JSON.stringify({ action: "unpublish" }),
        });
        window.location.reload();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Failed to unpublish.";
      } finally {
        setBusy(false);
      }
    });

    deleteBtn?.addEventListener("click", async () => {
      const postId = form.dataset.postId;
      if (!postId || !confirm("Delete this blog post?")) return;

      status.textContent = "Deleting...";
      setBusy(true);
      try {
        await requestJson(`/api/blogs/${postId}`, { method: "DELETE" });
        window.location.href = "/blogs/write";
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Failed to delete.";
      } finally {
        setBusy(false);
      }
    });

    newPostBtn?.addEventListener("click", () => {
      form.dataset.postId = "";
      titleInput.value = "";
      excerptInput.value = "";
      bodyInput.value = "";
      status.textContent = "New draft";
      history.replaceState(null, "", "/blogs/write");
      deleteBtn.disabled = true;
      titleInput.focus();
    });
  </script>
</Base>

<style>
  .write-page {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .write-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .write-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.1;
  }

  .write-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .write-user a {
    font-weight: 700;
    text-decoration: none;
  }

  .write-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .post-sidebar,
  .editor-panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--elevated);
  }

  .post-sidebar {
    padding: 0.75rem;
  }

  .new-post-btn {
    width: 100%;
    margin-bottom: 0.75rem;
  }

  .post-list {
    display: grid;
    gap: 0.5rem;
  }

  .post-list-item {
    display: grid;
    gap: 0.25rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    padding: 0.7rem;
    text-decoration: none;
  }

  .post-list-item--active,
  .post-list-item:hover {
    background: var(--sunken);
  }

  .post-list-item span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
  }

  .post-list-item small,
  .empty-list {
    color: var(--text-muted);
  }

  .empty-list {
    margin: 0;
    padding: 0.75rem;
  }

  .editor-panel {
    padding: 1rem;
  }

  .write-form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-md);
    background: var(--input-bg);
    color: var(--text);
    font: inherit;
  }

  input {
    padding: 0.9rem 1rem;
    font-size: 1.05rem;
  }

  textarea {
    min-height: 460px;
    padding: 1rem;
    resize: vertical;
    line-height: 1.6;
  }

  input:focus,
  textarea:focus {
    border-color: var(--input-focus);
    outline: none;
  }

  .write-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: space-between;
  }

  .write-status {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .write-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  button,
  .secondary-action {
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0.78rem 1rem;
    text-decoration: none;
  }

  button {
    background: var(--button-primary);
    color: white;
  }

  button:hover {
    background: var(--button-primary-hover);
  }

  .secondary-action {
    background: var(--button-secondary);
    color: var(--text);
  }

  .secondary-action:hover {
    background: var(--button-secondary-hover);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 820px) {
    .write-header,
    .write-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .write-shell {
      grid-template-columns: 1fr;
    }

    .write-user {
      white-space: normal;
    }
  }
</style>
